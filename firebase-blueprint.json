{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 1024 },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["uid", "email"]
    },
    "DocumentItem": {
      "title": "DocumentItem",
      "description": "Professional generated document stored in Firestore",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 256 },
        "field": { "type": "string", "maxLength": 64 },
        "documentType": { "type": "string", "maxLength": 64 },
        "topic": { "type": "string", "maxLength": 512 },
        "tone": { "type": "string", "maxLength": 64 },
        "outputLength": { "type": "string", "maxLength": 64 },
        "isFavorite": { "type": "boolean" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "userId", "title", "field", "documentType", "topic"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Stores user profiles with owner-only access"
    },
    "/documents/{documentId}": {
      "schema": "DocumentItem",
      "description": "Stores professional documents generated by authenticated users"
    }
  }
}
