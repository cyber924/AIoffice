rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUser(data) {
      return data.uid is string &&
             data.uid == request.auth.uid &&
             data.email is string &&
             data.email.size() <= 256;
    }

    function isValidDocument(data) {
      return data.id is string &&
             data.id.size() <= 128 &&
             data.userId is string &&
             data.userId == request.auth.uid &&
             data.title is string &&
             data.title.size() <= 256 &&
             data.field is string &&
             data.field.size() <= 64 &&
             data.documentType is string &&
             data.documentType.size() <= 64;
    }

    // User profiles collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && incoming().uid == existing().uid;
      allow delete: if isOwner(userId);
    }

    // Documents collection
    match /documents/{documentId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() &&
                      isValidId(documentId) &&
                      incoming().userId == request.auth.uid &&
                      isValidDocument(incoming());
      allow update: if isSignedIn() &&
                      isValidId(documentId) &&
                      existing().userId == request.auth.uid &&
                      incoming().userId == existing().userId &&
                      isValidDocument(incoming());
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // Connection testing doc
    match /test/connection {
      allow read: if true;
    }
  }
}
